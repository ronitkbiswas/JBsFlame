rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Phase 3: Primitives & Helpers
    function isSignedIn() { return request.auth != null; }
    function isVerified() { 
      return isSignedIn() && (request.auth.token.email_verified == true || request.auth.token.firebase.sign_in_provider == 'google.com'); 
    }

    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    function isOwner(uid) { return isSignedIn() && request.auth.uid == uid; }
    
    function isEmailAdmin() {
      return isSignedIn() && request.auth.token.email == 'ronitkbiswas@gmail.com';
    }

    function isAdmin() { 
      return isEmailAdmin();
    }
    
    // --- Match Blocks ---

    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /users/{uid} {
      allow get, update, delete: if isSignedIn() && (request.auth.uid == uid || isEmailAdmin() || isAdmin());
      allow list: if isEmailAdmin() || isAdmin();
      allow create: if isSignedIn() && request.auth.uid == uid;

      match /{allSubcollections=**} {
        allow read, write: if isSignedIn() && (request.auth.uid == uid || isEmailAdmin() || isAdmin());
      }
    }

    match /menu_items/{itemId} {
      allow read: if true;
      allow write: if isEmailAdmin() || isAdmin();
    }

    match /orders/{orderId} {
      allow get: if isSignedIn() && (resource.data.userId == request.auth.uid || isEmailAdmin() || isAdmin());
      allow list: if isSignedIn() && (
        (resource.data.userId == request.auth.uid) || 
        isEmailAdmin() || 
        isAdmin()
      );
      allow create: if isSignedIn() && incoming().userId == request.auth.uid;
      allow update: if isSignedIn() && (
        isEmailAdmin() || 
        isAdmin() || 
        (resource.data.userId == request.auth.uid && incoming().status == 'Cancelled' && resource.data.status == 'Pending') ||
        (resource.data.userId == request.auth.uid && incoming().get('cancellationRequested', false) == true)
      );
    }

    // --- Helper for Address Validation ---
    function isValidAddress(data) {
      return data.userId is string &&
             data.label is string &&
             data.lat is number &&
             data.lng is number &&
             data.type in ['Home', 'Work', 'Other'];
    }
  }
}
